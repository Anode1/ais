<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice recall: native SpeechRecognizer needs the mic. The permission is
         requested at runtime on the first mic tap (see lib/main.dart). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- LAN sync: pull from / serve to a peer on the local network. Flutter adds
         INTERNET only to the debug/profile manifests, so it must be declared here
         or sync fails silently in the release (Play) build. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- allowBackup: the index is the user's own plain text and nothing goes to any
         cloud. Android's default (true) makes the app eligible for Google auto-backup,
         which would upload it. false turns that off. On API 31+ it disables only the
         CLOUD path; device-to-device transfer still runs, and that is deliberate: a
         D2D transfer is a direct local handset-to-handset copy during setup with no
         server in the middle, so it keeps the promise.
         dataExtractionRules (API 31+) states the same split explicitly: deny
         cloud-backup, allow device-transfer. See res/xml/data_extraction_rules.xml.

         hasFragileUserData: sync between the user's own devices IS the backup. There
         is no cloud copy and no trash, so an uninstall would take the index with it.
         This makes Android's uninstall dialog offer a "Keep app data" checkbox. Not
         noise; do not remove it. -->
    <application
        android:label="AIS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Scan-to-join: the camera opens an ais://sync?host=..&token=.. link
                 (a QR the host device shows); Android routes it here and
                 lib/main.dart offers to join. No in-app QR scanner needed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ais" android:host="sync"/>
            </intent-filter>
            <!-- Share-sheet intake: other apps' Share for plain text lands here;
                 MainActivity forwards it over ais/share and the text prefills the
                 Add sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- so speech_to_text can see the on-device recognition service (Android 11+) -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- so canLaunchUrl can see a browser (Android 11+ package visibility) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
