<?xml version="1.0" encoding="utf-8"?>
<!-- data_extraction_rules.xml: what Android may take out of this app (API 31+).
     Referenced from AndroidManifest.xml as android:dataExtractionRules.

     The two sections are treated differently ON PURPOSE.

       cloud-backup    DENIED. Google auto-backup uploads to a Google server. The
                       index is the user's own plain text, is deliberately not
                       encrypted at rest, and the product promise is that nothing
                       goes to any cloud. Excluded whole, every domain.

       device-transfer ALLOWED. This is the direct handset-to-handset copy the setup
                       wizard runs when the user moves to a new phone: local,
                       user-initiated, no server sees the bytes. It is the same shape
                       as the app's own LAN sync, so it keeps the promise, and sync
                       between the user's own devices IS the backup here.

     path="." means the whole domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
