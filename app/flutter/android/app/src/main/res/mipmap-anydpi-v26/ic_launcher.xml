<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). Without this, every Android 8 and later device
     (everything above minSdk 24 bar API 24 and 25) takes the legacy square
     bitmap, shrinks it and masks it onto a shim background, so the icon reads
     smaller and boxier than every other icon on the home screen. The background
     is the artwork's own blue, so the foreground's rounded-rect edge vanishes
     into it and whatever mask the launcher applies cuts clean colour.
     The monochrome layer is what Android 13+ themed icons use. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
