<!-- Project meta for the OBS home project. Replace USER with the OBS login,
     then: osc meta prj -F project.xml home:USER:ais -->
<project name="home:USER:ais">
  <title>ais</title>
  <description>Associative index: file anything under your own keys and recall it by keys, in plain text. https://github.com/Anode1/ais</description>
  <person userid="USER" role="maintainer"/>
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="16.0">
    <path project="openSUSE:Leap:16.0" repository="standard"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="Fedora_44">
    <path project="Fedora:44" repository="standard"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="Fedora_43">
    <path project="Fedora:43" repository="standard"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="Debian_13">
    <path project="Debian:13" repository="standard"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="Debian_12">
    <path project="Debian:12" repository="standard"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="xUbuntu_26.04">
    <path project="Ubuntu:26.04" repository="universe"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
  <repository name="xUbuntu_24.04">
    <path project="Ubuntu:24.04" repository="universe"/>
    <arch>x86_64</arch><arch>aarch64</arch>
  </repository>
</project>
